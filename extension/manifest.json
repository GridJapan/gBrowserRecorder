{
  "manifest_version": 3,
  "name": "gBrowserRecorder",
  "version": "1.0.0",
  "description": "ブラウザのタブ単位で、映像と音声（タブの音＋マイク）を mp4 に録画します。",
  "minimum_chrome_version": "126",
  "permissions": ["downloads", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "gBrowserRecorder: タブを録画",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
